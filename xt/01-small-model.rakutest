use v6.d;
use lib 'lib';
use Test;
use Gurobi;

plan 7;
my $solver = try { Gurobi::Solver.new };
unless $solver.defined {
    skip-rest 'a usable Gurobi license is not installed';
    exit;
}
my $model = $solver.create-model('small-model-test');
my @vars = ($model.add-var(:obj(1), :vtype('B'), :name<x>), $model.add-var(:obj(1), :vtype('B'), :name<y>), $model.add-var(:obj(2), :vtype('B'), :name<z>));
is $model.num-vars, 3, 'three variables were added';
$model.add-constr([0, 1, 2], [1, 2, 3], :sense('<'), :rhs(4), :name<capacity>);
$model.add-constr([0, 1], [1, 1], :sense('>'), :rhs(1), :name<coverage>);
$model.maximize;
is $model.optimize, GRB-OPTIMAL, 'small binary model solves optimally';
is-approx $model.objective-value, 3e0, 'optimal objective is 3';
is-approx $model.value(@vars[0]), 1e0, 'x is 1';
is-approx $model.value(@vars[1]), 0e0, 'y is 0';
is-approx $model.value(@vars[2]), 1e0, 'z is 1';
ok $model.free, 'model can be explicitly released';
